---
import JsonLd from './JsonLd.astro';
import { personLd, websiteLd } from '../lib/ld';
import { altLang, localePath, type Lang } from '../i18n/ui';
export interface SeoProps {
  lang: Lang; title: string; description: string; path: string;
  altPath?: string; ogImage?: string; jsonld?: object[]; noindex?: boolean; ogType?: string;
}
const { lang, title, description, path, altPath, ogImage, jsonld = [], noindex = false, ogType = 'website' } = Astro.props as SeoProps;
const site = Astro.site!;
const canonical = new URL(path, site).href;
const other = new URL(altPath ?? localePath(altLang(lang), '/'), site).href;
const fr = lang === 'fr' ? canonical : other;
const en = lang === 'en' ? canonical : other;
const ogSlug = path === '/' ? 'index' : path.replace(/^\/|\/$/g, '').replaceAll('/', '-');
const image = new URL(ogImage ?? `/og/${ogSlug}.png`, site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="fr" href={fr} />
<link rel="alternate" hreflang="en" href={en} />
<link rel="alternate" hreflang="x-default" href={fr} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Mario Ratiarivony" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<link rel="alternate" type="application/rss+xml" title="Blog — Mario Ratiarivony" href={new URL(localePath(lang, '/rss.xml'), site).href} />
<JsonLd items={[websiteLd(), personLd(), ...jsonld]} />
