---
import { Image } from 'astro:assets';
import { localePath, type Lang } from '../i18n/ui';
import { slugOf, kindLabel, type Projet } from '../lib/content';
interface Props { p: Projet; lang: Lang; size?: 'xl' | 'md' | 'sm'; eager?: boolean }
const { p, lang, size = 'md', eager = false } = Astro.props;
const href = localePath(lang, `/projets/${slugOf(p)}/`);
const widths = size === 'xl' ? [640, 960, 1440, 2000] : [480, 720, 960];
const sizes = size === 'xl' ? '(min-width: 1240px) 1240px, 100vw' : '(min-width: 900px) 600px, 100vw';
---
<article class={`card ${size} reveal`}>
  <a href={href} class="media" tabindex="-1" aria-hidden="true">
    <Image src={p.data.cover} alt={p.data.coverAlt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  </a>
  <div class="body">
    <p class="meta mono"><span>{kindLabel(lang, p.data.kind)}</span><span>{p.data.year}</span></p>
    <h3><a href={href}>{p.data.title}</a></h3>
    <p class="tagline">{p.data.tagline}</p>
    <ul class="tags">{p.data.stack.slice(0, size === 'sm' ? 3 : 5).map((s) => <li>{s}</li>)}</ul>
  </div>
</article>
<style>
  .card { display: grid; gap: 18px; position: relative; }
  .media { display: block; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--line); background: var(--paper-2); box-shadow: var(--shadow); aspect-ratio: 16 / 10; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
  .card:hover .media :global(img) { transform: scale(1.025); }
  .body { display: grid; gap: 8px; }
  .meta { display: flex; justify-content: space-between; color: var(--muted); margin: 0; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .card:hover h3 a { color: var(--rust); }
  .tagline { color: var(--ink-2); margin: 0 0 6px; max-width: 60ch; }
  .tags { position: relative; z-index: 1; }
  .xl { grid-template-columns: 1.6fr 1fr; align-items: end; gap: clamp(20px, 4vw, 48px); }
  .xl h3 { font-size: var(--step-3); }
  .sm h3 { font-size: var(--step-1); font-family: var(--sans); font-weight: 600; }
  .sm .media { aspect-ratio: 16 / 11; }
  @media (max-width: 860px) { .xl { grid-template-columns: 1fr; } }
</style>
