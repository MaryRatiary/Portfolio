---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Item { src: ImageMetadata; alt: string; caption: string; wide?: boolean }
interface Props { items: Item[]; lang: 'fr' | 'en' }
const { items, lang } = Astro.props;
const isMobile = (i: Item) => i.src.height > i.src.width;
---
<div class="gallery">
  {items.map((it, k) => (
    <figure class:list={['shot reveal', { tall: isMobile(it), wide: it.wide }]}>
      <button type="button" class="zoom" data-full={it.src.src} data-alt={it.alt} aria-label={lang === 'fr' ? `Agrandir : ${it.alt}` : `Enlarge: ${it.alt}`}>
        <Image src={it.src} alt={it.alt} widths={isMobile(it) ? [320, 480, 780] : [480, 960, 1440]} sizes={isMobile(it) ? '(min-width: 900px) 300px, 60vw' : '(min-width: 1240px) 1240px, 100vw'} loading={k < 1 ? 'eager' : 'lazy'} />
      </button>
      <figcaption><span class="mono">{String(k + 1).padStart(2, '0')}</span> {it.caption}</figcaption>
    </figure>
  ))}
</div>
<dialog class="lightbox" aria-label={lang === 'fr' ? 'Image agrandie' : 'Enlarged image'}>
  <form method="dialog"><button class="close" aria-label={lang === 'fr' ? 'Fermer' : 'Close'}>×</button></form>
</dialog>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const img = document.createElement('img');
  dlg?.append(img);
  document.querySelectorAll<HTMLButtonElement>('.gallery .zoom').forEach((b) =>
    b.addEventListener('click', () => {
      if (!dlg) return;
      img.src = b.dataset.full!; img.alt = b.dataset.alt!; dlg.showModal();
    }),
  );
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
<style>
  .gallery { display: grid; grid-template-columns: repeat(6, 1fr); gap: clamp(16px, 3vw, 32px); }
  .shot { grid-column: span 3; margin: 0; display: grid; gap: 10px; align-content: start; }
  .shot.wide, .shot:first-child { grid-column: 1 / -1; }
  .shot.tall { grid-column: span 2; }
  .zoom { all: unset; cursor: zoom-in; display: block; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--paper-2); box-shadow: var(--shadow); }
  .zoom:focus-visible { outline: 2px solid var(--rust); outline-offset: 3px; }
  .zoom :global(img) { width: 100%; height: auto; }
  figcaption { font-size: var(--step--1); color: var(--muted); }
  figcaption .mono { color: var(--rust); margin-right: 6px; }
  .lightbox { max-width: min(96vw, 1600px); max-height: 94vh; padding: 0; border: 0; border-radius: 12px; background: var(--card); }
  .lightbox::backdrop { background: #0c0a08d9; }
  .lightbox img { max-height: 92vh; width: auto; margin: auto; }
  .close { position: absolute; top: 8px; right: 8px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--ink); color: var(--paper); font-size: 24px; cursor: pointer; }
  @media (max-width: 760px) {
    .shot, .shot.tall { grid-column: 1 / -1; }
    .shot.tall { width: 72%; justify-self: center; }
  }
</style>
