---
import { t, localePath, altLang, type Lang } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
interface Props { lang: Lang; path: string; altPath?: string }
const { lang, path, altPath } = Astro.props;
const links = [
  { href: localePath(lang, '/projets/'), label: t(lang, 'nav.projects') },
  { href: localePath(lang, '/services/'), label: t(lang, 'nav.services') },
  { href: localePath(lang, '/a-propos/'), label: t(lang, 'nav.about') },
  { href: localePath(lang, '/blog/'), label: t(lang, 'nav.blog') },
];
const other = altPath ?? localePath(altLang(lang), '/');
const isActive = (href: string) => path.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(lang, '/')}>
      <span class="mark" aria-hidden="true">M</span>
      <span class="name">Mario Ratiarivony<small>{t(lang, 'role')}</small></span>
    </a>
    <nav aria-label="Navigation principale">
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="lang" href={other} hreflang={altLang(lang)} lang={altLang(lang)} title={t(lang, 'lang')}>{t(lang, 'langShort')}</a>
      <ThemeToggle lang={lang} />
      <a class="btn btn-primary cta" href={localePath(lang, '/contact/')}>{t(lang, 'nav.contact')}</a>
    </div>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 96%, transparent); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--ink); color: var(--paper); font: italic 400 22px/1 var(--serif); }
  .name { display: flex; flex-direction: column; font-weight: 600; font-size: 0.95rem; line-height: 1.2; }
  .name small { font: 400 0.72rem/1.3 var(--mono); color: var(--muted); letter-spacing: 0.04em; }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding: 8px 12px; border-radius: 999px; text-decoration: none; font-size: 0.92rem; color: var(--ink-2); }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); background: var(--rust-soft); }
  .actions { display: flex; align-items: center; gap: 8px; }
  .lang { font: 500 0.78rem/1 var(--mono); text-decoration: none; padding: 10px; border-radius: 999px; border: 1px solid var(--line-strong); }
  .cta { padding: 0.7em 1.1em; }
  @media (max-width: 900px) {
    .bar { flex-wrap: wrap; gap: 8px 12px; min-height: 0; padding-block: 10px; }
    .name small { display: none; }
    .actions { margin-left: auto; }
    nav { order: 3; width: 100%; margin: 0 -6px; overflow-x: auto; scrollbar-width: none; }
    nav ul { gap: 0; }
    nav a { padding: 6px 10px; font-size: 0.88rem; white-space: nowrap; }
  }
  @media (max-width: 380px) { .cta { display: none; } }
</style>
