---
import { t, localePath, type Lang } from '../i18n/ui';
import Views from './Views.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
const L = (p: string) => localePath(lang, p);
const fr = lang === 'fr';
---
<footer class="site-footer">
  <div class="container grid">
    <div class="intro">
      <p class="big">{fr ? <>Un projet web en tête&nbsp;? <em>Parlons-en.</em></> : <>Got a web project in mind? <em>Let’s talk.</em></>}</p>
      <a class="btn btn-primary" href={L('/contact/')}>{t(lang, 'cta.project')} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <nav aria-label={fr ? 'Plan du site' : 'Sitemap'}>
      <p class="eyebrow">{fr ? 'Pages' : 'Pages'}</p>
      <ul>
        <li><a href={L('/projets/')}>{t(lang, 'nav.projects')}</a></li>
        <li><a href={L('/services/')}>{t(lang, 'nav.services')}</a></li>
        <li><a href={L('/a-propos/')}>{t(lang, 'nav.about')}</a></li>
        <li><a href={L('/blog/')}>{t(lang, 'nav.blog')}</a></li>
        <li><a href={L('/contact/')}>{t(lang, 'nav.contact')}</a></li>
      </ul>
    </nav>
    <div>
      <p class="eyebrow">{fr ? 'Ailleurs' : 'Elsewhere'}</p>
      <ul>
        <li><a href="https://www.linkedin.com/in/mario-mamitantely-ratiarivony/" rel="me noopener" target="_blank">LinkedIn</a></li>
        <li><a href="https://github.com/MaryRatiary" rel="me noopener" target="_blank">GitHub</a></li>
        <li><a href="mailto:maryratiary@gmail.com">maryratiary@gmail.com</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <span>© {year} · {t(lang, 'rights')}</span>
    <span class="mono">{t(lang, 'location')}</span>
    <Views lang={lang} />
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-top: clamp(48px, 8vw, 96px); background: var(--paper-2); }
  .grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; padding-bottom: 48px; }
  .big { font: 400 var(--step-3)/1.05 var(--serif); margin-bottom: 24px; max-width: 16ch; }
  .big em { color: var(--rust); }
  ul { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
  ul a { text-decoration: none; color: var(--ink-2); }
  .legal { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding-block: 20px 28px; border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } .intro { grid-column: 1 / -1; } }
</style>
